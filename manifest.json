{
  "manifest_version": 2,
  "core_api_major": 4,
  "package_version": "1.0.0",
  "id": "godot_party_default_auction_master",
  "name": "GodotPartyDefault · 竞拍大师",
  "kind": "minigame",
  "entry": "game.tscn",
  "player_counts": [
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    8
  ],
  "tags": [
    "original"
  ],
  "dependencies": {
    "godot_party_default_protocol": "1.0.0"
  },
  "adapters": [
    {
      "id": "standard",
      "protocol": {
        "id": "godot_party_default_protocol",
        "api_major": 1,
        "min_api_minor": 0
      },
      "entry": "adapter.gd"
    }
  ],
  "config_schema": "settings.gd",
  "streams": {
    "state": {
      "mode": "reliable",
      "audience": "instance"
    },
    "private_view": {
      "mode": "reliable",
      "audience": "instance"
    },
    "cursors": {
      "mode": "ordered",
      "audience": "instance"
    }
  },
  "introduction": "1–8 人暗标竞拍，单人可测试；前四轮可提前成交，第五轮同价加拍，鉴定与同仓羁绊决定估值。",
  "localization": {
    "supported_locales": [
      "zh_Hans"
    ],
    "fallback_locale": "zh_Hans",
    "translations": {
      "zh_Hans": "i18n/zh_Hans.po"
    }
  }
}
