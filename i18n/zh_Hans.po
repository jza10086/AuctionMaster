msgid "hud.item"
msgstr "{quality} · {width} × {height} 格\n{value} 金币\n{tags}"

msgid "hud.valuation"
msgstr "基础 {base}  +  羁绊 {bonus}  =  总值 {total}"

msgid "hud.clock"
msgstr "仓库 {current} / {total} · {round} · 剩余 {time} 秒 · {phase}"

