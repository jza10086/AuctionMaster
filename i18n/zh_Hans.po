msgid "1–8 人暗标竞拍，单人可测试；前四轮可提前成交，第五轮同价加拍，鉴定与同仓羁绊决定估值。"
msgstr "1–8 人暗标竞拍，单人可测试；前四轮可提前成交，第五轮同价加拍，鉴定与同仓羁绊决定估值。"

msgid "hud.solo"
msgstr "单人竞拍测试"

msgid "GodotPartyDefault · 竞拍大师"
msgstr "GodotPartyDefault · 竞拍大师"

msgid "仓库数量"
msgstr "仓库数量"

msgid "初始金币"
msgstr "初始金币"

